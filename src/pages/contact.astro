---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { applicationFormUrl } from "../data/site";
---

<BaseLayout title="Contact — SERA Lab." description="Contact SERA Lab at Korea University.">
  <PageIntro
    eyebrow="Contact"
    title="Contact us."
    copy="Research inquiries, collaboration, and student applications. We are in the Department of Computer Science and Engineering at Korea University."
  />

  <section class="section section--paper contact-page">
    <div class="shell contact-page__grid">
      <div class="contact-card contact-card--primary">
        <span class="eyebrow">Email</span>
        <a href="mailto:seyeon625@korea.ac.kr">seyeon625@korea.ac.kr <span aria-hidden="true">↗</span></a>
      </div>
      <div class="contact-card">
        <span class="eyebrow">Phone</span>
        <a href="tel:+82232903973">+82 2 3290 3973 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="contact-card">
        <span class="eyebrow">Office</span>
        <p>Room 501A<br />Woojung Hall of Informatics<br />Korea University, Seoul</p>
      </div>
    </div>
  </section>

  <section class="section contact-apply-section" aria-labelledby="contact-apply-title">
    <div class="shell contact-apply">
      <div class="contact-apply__copy">
        <p class="eyebrow">Join SERA · Recruiting year-round</p>
        <h2 id="contact-apply-title">Your next research starts here.</h2>
        <p>Interested in joining as a graduate student or undergraduate researcher? Tell us about your interests through our application form. No prior email needed.</p>
      </div>
      <div class="contact-apply__actions">
        <a class="button button--light" href={applicationFormUrl} target="_blank" rel="noopener noreferrer">Apply via Google Form <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/join/">Explore opportunities <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section contact-map-section">
    <div class="shell contact-map">
      <div class="contact-map__copy">
        <p class="eyebrow">Visit</p>
        <h2>Woojung Hall of Informatics</h2>
        <p>145 Anam-ro, Seongbuk-gu, Seoul, Republic of Korea</p>
        <a class="text-link" href="https://maps.google.com/?q=37.58501956378139,127.02859960408954" target="_blank" rel="noreferrer">Open in Google Maps <span aria-hidden="true">↗</span></a>
      </div>
      <div class="contact-map__graphic">
        <iframe
          title="Google Map showing SERA Lab at Woojung Hall of Informatics"
          src="https://maps.google.com/maps?width=100%25&amp;height=600&amp;hl=en&amp;q=Woojung%20Hall%20of%20Informatics%2C%20Korea%20University&amp;t=&amp;z=17&amp;ie=UTF8&amp;iwloc=B&amp;output=embed"
          loading="eager"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
