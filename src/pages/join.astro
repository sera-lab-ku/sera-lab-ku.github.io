---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
---

<BaseLayout title="Join us — SERA Lab." description="Join SERA Lab at Korea University.">
  <PageIntro
    eyebrow="Join SERA"
    title="Bring an interesting systems question."
    copy="We welcome people who are comfortable crossing boundaries: theory and implementation, AI and systems, ambitious ideas and careful measurements."
  />

  <section class="section section--paper join-page">
    <div class="shell join-page__grid">
      <div class="join-page__intro">
        <p class="eyebrow">Who we are looking for</p>
        <h2>Curiosity is the starting point. Follow-through is the craft.</h2>
        <p>Whether you are exploring research for the first time or arriving with a project already in mind, we care about technical care, a bias toward building, and generous collaboration.</p>
      </div>
      <div class="opportunity-list">
        <article><span>01</span><div><h3>Graduate students</h3><p>Research toward M.S. and Ph.D. degrees across our core systems areas.</p></div></article>
        <article><span>02</span><div><h3>Undergraduate researchers</h3><p>Start with a scoped project, build research fluency, and grow into a sustained contribution.</p></div></article>
        <article><span>03</span><div><h3>Collaborators &amp; visitors</h3><p>We are glad to meet people with complementary questions, methods, or testbeds.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section section--ink application-flow">
    <div class="shell">
      <p class="eyebrow eyebrow--light">A simple first step</p>
      <div class="application-flow__grid">
        <h2>Tell us what you want to understand or build.</h2>
        <ol>
          <li><span>01</span><p>Read the research areas and choose a question that genuinely interests you.</p></li>
          <li><span>02</span><p>Send a short email with your background, CV, and one or two ideas you want to explore.</p></li>
          <li><span>03</span><p>We will arrange a conversation if there is a strong match.</p></li>
        </ol>
      </div>
      <a class="button button--light" href="mailto:seyeon625@korea.ac.kr?subject=Interest%20in%20joining%20SERA%20Lab">Start a conversation <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
