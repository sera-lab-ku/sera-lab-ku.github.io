---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
---

<BaseLayout title="Join us — SERA Lab." description="Join SERA Lab at Korea University.">
  <PageIntro
    eyebrow="Join SERA · Recruiting year-round"
    title="Join us."
    copy="SERA Lab is looking for graduate students and undergraduate researchers in extended reality, edge AI, multi-agent, and networked systems."
  />

  <section class="section section--paper join-page">
    <div class="shell join-page__grid">
      <div class="join-page__intro">
        <p class="eyebrow">Who we are looking for</p>
        <h2>Open positions</h2>
      </div>
      <div class="opportunity-list">
        <article><span>01</span><div><h3>Graduate students</h3><p>M.S. and Ph.D. positions in any of our four research areas.</p></div></article>
        <article><span>02</span><div><h3>Undergraduate researchers</h3><p>A scoped project with a graduate student mentor, typically one to two semesters.</p></div></article>
        <article><span>03</span><div><h3>Collaborators &amp; visitors</h3><p>Visiting researchers and joint projects with complementary methods or testbeds.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section section--ink application-flow">
    <div class="shell">
      <p class="eyebrow eyebrow--light">How to apply</p>
      <div class="application-flow__grid">
        <h2>Send the form. That is the whole process.</h2>
        <ol>
          <li><span>01</span><p>Submit the application form. It asks for the research area you want to work on, when you can start, and an optional CV.</p></li>
          <li><span>02</span><p>If you have a question before applying, email Prof. Kim directly.</p></li>
          <li><span>03</span><p>We read every submission and reply to arrange a meeting when there is a match.</p></li>
        </ol>
      </div>
      <div class="application-flow__actions">
        <a
          class="button button--light"
          href="https://docs.google.com/forms/d/e/1FAIpQLSeAnj70hrt7R7Asfrycud-yz-zSpkPSczDkFA2dOMluAJ-hdg/viewform?usp=dialog"
          target="_blank"
          rel="noopener noreferrer"
        >Apply via Google Form <span aria-hidden="true">↗</span></a>
        <a
          class="button button--ghost"
          href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=seyeon625%40korea.ac.kr&amp;su=Question%20about%20joining%20SERA%20Lab"
          target="_blank"
          rel="noopener noreferrer"
        >Ask a question by email <span aria-hidden="true">↗</span></a>
      </div>
      <p class="application-flow__note">Applying does not require a prior email. If you are unsure whether you fit, send the form anyway.</p>
    </div>
  </section>
</BaseLayout>
