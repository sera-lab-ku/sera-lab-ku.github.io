---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publications } from "../data/site";

const years = [...new Set(publications.map((publication) => publication.year))];
---

<BaseLayout title="Publications — SERA Lab." description="Publications from SERA Lab at Korea University.">
  <div class="page-nav-band" aria-hidden="true"></div>

  <section class="section section--paper publications-page">
    <div class="shell">
      <header class="content-divider"><h1>Publication</h1></header>
      <div class="publications-page__summary"><span>{publications.length} selected publications</span><span>2021 — 2026</span></div>
      {years.map((year) => (
        <section class="publication-year" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <div class="publication-list">
            {publications.filter((publication) => publication.year === year).map((paper) => (
              <article class="publication-row">
                <div class="publication-row__image">{paper.image && <img src={paper.image} alt="" loading="lazy" />}</div>
                <div class="publication-row__content">
                  <div class="publication-row__meta"><span>{paper.type}</span><span>{paper.venue}</span>{paper.note && <span class="status-pill">{paper.note}</span>}</div>
                  <h3>{paper.title}</h3>
                  {paper.authors && <p>{paper.authors}</p>}
                </div>
                {paper.link ? (
                  <a class="publication-row__link" href={paper.link} target="_blank" rel="noreferrer" aria-label={`Read ${paper.title}`}>↗</a>
                ) : (
                  <span class="publication-row__link publication-row__link--muted" title="Paper link forthcoming">·</span>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
