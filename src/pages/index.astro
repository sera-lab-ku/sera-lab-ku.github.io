---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { featuredPublications, news, researchAreas, splitNewsTitle } from "../data/site";
import { getImage } from "astro:assets";
import campus from "../../photo/campus_4k.jpeg";

const campusBackground = await getImage({
  src: campus,
  width: 3840,
  format: "webp",
  quality: 85,
});
---

<BaseLayout
  title="SERA Lab. — Systems for Extended Reality and AI"
  description="SERA Lab at Korea University builds rigorous systems for extended reality and AI."
>
  <section class="hero hero--campus" style={`--hero-image: url(${campusBackground.src})`}>
    <div class="hero__noise" aria-hidden="true"></div>
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--light">Korea University · Computer Science &amp; Engineering</p>
        <h1>Systems that make <em>intelligence</em> tangible.</h1>
        <p class="hero__lede">
          We build the systems layer behind extended reality and AI: responsive media, capable edge devices, and infrastructure that learns.
        </p>
        <div class="hero__actions">
          <a class="button button--light" href="/research/">Explore our research <span aria-hidden="true">↘</span></a>
          <a class="button button--ghost" href="/join/">Work with us <span aria-hidden="true">↗</span></a>
        </div>
      </div>

    </div>
    <div class="shell hero__footer">
      <span>Scroll to enter</span>
      <span class="hero__line" aria-hidden="true"></span>
      <span>Seoul · Republic of Korea</span>
    </div>
  </section>

  <section class="section section--paper section--research">
    <div class="shell">
      <SectionHeading
        eyebrow="Research focus"
        title="We work where systems become felt."
        copy="Our questions are technical, but the outcome is human: experiences that feel immediate, intelligence that fits in the world, and infrastructure that earns trust."
        link={{ href: "/research/", label: "See all research areas" }}
      />
      <div class="research-grid">
        {researchAreas.map((area) => (
          <article class="research-card">
            <div class="research-card__top"><span>{area.index}</span><span class="research-card__arrow">↗</span></div>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
            <ul class="tag-list">
              {area.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink feature-band">
    <div class="shell feature-band__grid">
      <div class="feature-band__statement">
        <p class="eyebrow eyebrow--light">A systems view</p>
        <p>Better experiences are not a layer on top of infrastructure. They are a property of the whole system.</p>
      </div>
      <div class="feature-band__metrics">
        <div><strong>XR</strong><span>Real-time, immersive media</span></div>
        <div><strong>AI</strong><span>Useful intelligence at the edge</span></div>
        <div><strong>SYS</strong><span>Adaptive networked infrastructure</span></div>
      </div>
    </div>
  </section>

  <section class="section section--paper section--publications">
    <div class="shell">
      <SectionHeading
        eyebrow="Selected work"
        title="Research with a clear path to impact."
        copy="A selection of recent papers across immersive systems, scalable media, and learning-driven infrastructure."
        link={{ href: "/publications/", label: "Browse publications" }}
      />
      <div class="featured-publications">
        {featuredPublications.map((paper, index) => (
          <article class={`featured-paper featured-paper--${index + 1}`}>
            <div class="featured-paper__image-wrap">
              {paper.image && <img src={paper.image} alt="" loading="lazy" />}
              <span>{paper.year}</span>
            </div>
            <div class="featured-paper__content">
              <p class="publication-meta">{paper.venue} · {paper.type}</p>
              <h3>{paper.title}</h3>
              {paper.note && <span class="status-pill">{paper.note}</span>}
              {paper.link ? (
                <a class="text-link" href={paper.link} target="_blank" rel="noreferrer">Read paper <span aria-hidden="true">↗</span></a>
              ) : (
                <span class="forthcoming">Paper link forthcoming</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper section--news">
    <div class="shell">
      <SectionHeading
        eyebrow="Lab pulse"
        title="What is moving at SERA."
        copy="New work, new people, and milestones from the lab."
      />
      <div class="news-list">
        {news.map((item) => (
          <article class="news-item">
            <span class="news-item__date">{item.date}</span>
            <span class="news-item__label">{item.label}</span>
            <h3>{splitNewsTitle(item).map((segment) => (
              segment.venue ? <span class="news-item__venue">{segment.text}</span> : segment.text
            ))}</h3>
            <span class="news-item__arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section join-banner">
    <div class="shell join-banner__inner">
      <div>
        <p class="eyebrow">Build with us</p>
        <h2>Curious people make strong systems.</h2>
      </div>
      <a class="button button--dark" href="/join/">Join SERA <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
