---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { publicationsByArea, researchAreas } from "../data/site";
import { getImage } from "astro:assets";
import campus from "../../photo/campus_4k.jpeg";

const campusBackground = await getImage({
  src: campus,
  width: 3840,
  format: "webp",
  quality: 85,
});
---

<BaseLayout title="Research — SERA Lab." description="Research areas at SERA Lab: extended reality, edge AI, multi-agent systems, and networked systems.">
  <PageIntro
    eyebrow="Research"
    title="Research areas."
    copy="We build and measure systems under the constraints they actually run in: variable networks, limited devices, and latency budgets that users notice when you miss them."
    backgroundImage={campusBackground.src}
  />

  <section class="section section--paper research-detail">
    <div class="shell">
      {researchAreas.map((area, index) => (
        <article class="research-detail__row">
          <div class="research-detail__index"><span>{area.index}</span></div>
          <div class="research-detail__main">
            <h2>{area.title}</h2>
            <p>{area.description}</p>
            <ul class="tag-list">{area.tags.map((tag) => <li>{tag}</li>)}</ul>
            {publicationsByArea(area.id).length > 0 && (
              <ul class="research-detail__papers">
                {publicationsByArea(area.id).map((paper) => (
                  <li>
                    <span class="research-detail__venue">{paper.venue} {paper.year}</span>
                    {paper.link
                      ? <a href={paper.link} target="_blank" rel="noreferrer">{paper.title}</a>
                      : <span>{paper.title}</span>}
                  </li>
                ))}
              </ul>
            )}
          </div>
          <div class={`research-detail__visual research-detail__visual--${index + 1}`} aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
