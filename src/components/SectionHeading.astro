---
interface Props {
  eyebrow?: string;
  title: string;
  copy?: string;
  link?: { href: string; label: string };
}

const { eyebrow, title, copy, link } = Astro.props;
---

<div class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
  </div>
  <div class="section-heading__aside">
    {copy && <p>{copy}</p>}
    {link && <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>}
  </div>
</div>
